{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://gen-lang-client-0246323734.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://gen-lang-client-0246323734.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/((?!assets/|__/auth/|__/firebase/).*)",
      "destination": "/index.html"
    }
  ]
}
